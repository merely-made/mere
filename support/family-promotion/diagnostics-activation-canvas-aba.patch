+
+#[test]
+fn same_call_recreation_must_retire_old_pin() {
+    use mere::kernel::graph::apply::{GraphDelta, GraphDeltaResult, apply_graph_delta};
+    let canvas = sample_canvas();
+    let mut host = harness(canvas.clone(), Plant::None);
+    let old = canvas.borrow().describe_items(DESCRIBED_ITEMS).items[0].clone();
+    let stale = host.a11y_produced_actions().into_values().find(|a| a.key == old.key && a.id == PIN_INTENT).unwrap();
+    let old_slot = canvas.borrow().graph().get_node_key_by_id(old.member).unwrap();
+    assert!(canvas.borrow_mut().ingest_graph(|graph| {
+        assert!(matches!(apply_graph_delta(graph, GraphDelta::RemoveNode { key: old_slot }), GraphDeltaResult::NodeRemoved(true)));
+        assert!(matches!(apply_graph_delta(graph, GraphDelta::AddNode { id: Some(old.member), url: "https://same-call.example/".into(), position: Default::default() }), GraphDeltaResult::NodeAdded(_)));
+        true
+    }));
+    host.a11y_produced_request(A11yAction::Click, stale);
+    let current = canvas.borrow().graph().get_node_key_by_id(old.member).unwrap();
+    assert_ne!(canvas.borrow().arrangement_role_of(current), ItemRole::Pinned, "old captured Pin must not act on same-call recreation");
+}
