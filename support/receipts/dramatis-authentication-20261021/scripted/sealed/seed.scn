await {"ready": "true", "profiles": "2", "locked": "false"}
wait 300000
capture /Users/markik/Code/output/dauth21/scripted/sealed/before.png
click role:button Change passphrase…
await {"notice": "~cancelled"}
wait 300000
capture /Users/markik/Code/output/dauth21/scripted/sealed/cancelled.png
click role:button Change passphrase…
await {"notice": "~current passphrase was not accepted"}
wait 300000
capture /Users/markik/Code/output/dauth21/scripted/sealed/wrong-current.png
click role:button Change passphrase…
await {"notice": "~did not match"}
wait 300000
capture /Users/markik/Code/output/dauth21/scripted/sealed/mismatch.png
click role:button Change passphrase…
await {"notice": "~cannot be empty"}
wait 300000
