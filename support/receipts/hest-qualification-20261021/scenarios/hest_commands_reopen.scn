# Run in a NEW browser process after hest_commands_save.scn, on the same origin: the
# kept command came back from the session, and is then removed again.
assert title GRAPHSHELL H3 READY
pointer down right 1000 150
settle 1
pointer up right 1000 150
settle 2
assert snap command-menu == open
assert retained {"class":"tree-command-menu","text":"Projection: order by tempo"}
capture hest-restored-command
click role:button @data-command-menu=drop:projection-scatter
settle 6
assert snap session-store == stored
key Escape
settle 2
assert snap command-menu == closed
log command menu fresh-page reload complete
