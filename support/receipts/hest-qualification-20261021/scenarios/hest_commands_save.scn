# Hest choice persistence slice of canvas_commands.scn; unrelated drag tests
# are omitted. Run on tree.html?app=local with an isolated managed profile.
assert title GRAPHSHELL H3 READY
# A right click on empty canvas opens the menu: search, then the kept commands.
pointer down right 1000 150
settle 1
pointer up right 1000 150
settle 2
assert snap command-menu == open
assert retained {"class":"tree-command-menu","text":"Zoom in"}
assert retained {"class":"tree-command-menu","text":"Fit to view"}
click role:textbox Search commands
input-text tempo
settle 2
assert retained {"class":"tree-command-menu","text":"Projection: order by tempo"}
click role:button @data-command-menu=keep:projection-scatter
settle 6
assert snap session-store == stored
capture hest-kept-command
key Escape
settle 2
assert snap command-menu == closed
# Reopened, the kept command is in the menu without a search.
pointer down right 1000 150
settle 1
pointer up right 1000 150
settle 2
assert retained {"class":"tree-command-menu","text":"Projection: order by tempo"}
click role:button @data-command-menu=run:view:zoom_in
settle 6
assert snap command-menu == closed
assert snap session-store == stored
capture canvas_commands
wait
log canvas pan, right-drag select and command menu proof complete
