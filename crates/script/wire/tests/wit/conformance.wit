package test:conformance@0.0.0;

/// Types another interface borrows.
interface shared {
    enum color { red, green, blue }

    /// Ten flags, so two bytes on the wire.
    flags perms { a, b, c, d, e, f, g, h, i, j }

    record numbers {
        a: s8,
        b: s16,
        c: s32,
        d: s64,
        e: u16,
        f: f32,
        g: f64,
        h: char,
    }

    resource token;
}

/// Every type our generator supports, nested, with Rust keywords for names.
interface values {
    use shared.{color, perms, numbers, token};

    record point {
        x: u32,
        y: u64,
        %type: string,
        %match: bool,
    }

    variant shape {
        empty,
        dot(point),
        bytes(list<u8>),
        many(list<point>),
        named(string),
        nested(option<result<u64, string>>),
        painted(color),
    }

    record bag {
        flag: bool,
        small: u8,
        shapes: list<shape>,
        pair: tuple<u32, string>,
        triple: tuple<u8, list<u8>, option<u64>>,
        maybe: option<option<u8>>,
        outcome: result<_, shape>,
        ok-only: result<point>,
        colors: list<color>,
        perms: perms,
        numbers: list<numbers>,
        nine: tuple<u8, u8, u8, u8, u8, u8, u8, u8, char>,
        token: option<token>,
    }

    resource handle {
        constructor(seed: u32);
        make: static func(name: string) -> handle;
        %type: func(%match: u32) -> u32;
    }

    echo: func(value: bag) -> bag;
    %type: func(%loop: u32) -> result<handle, shape>;
}

world conformance {
    import values;
}
