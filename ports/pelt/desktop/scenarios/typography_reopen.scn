log Pelt fresh process restores shared typography and app choice
settle 4
assert snap dirty == false
assert snap saved == true
assert snap mode == light
assert snap font_catalog == ready
click role:button @data-font-role=ui
assert snap font_family == serif
assert snap font_size == 15
assert snap font_line_height == 1.2
capture reopened_interface
click role:button @data-font-role=reading
assert snap font_family == Georgia
assert snap font_size == 24
assert snap font_line_height == 1.7
assert snap paragraph_size == 24px
assert snap font_diagnostics == none
capture reopened_reading
click .chrome-specimen
settle 4
capture reopened_previews
click role:button @data-action=reset-font-role
assert snap paragraph_size == 14px
capture reset_previews
click role:button @data-action=discard
assert snap paragraph_size == 24px
capture discarded_previews
captures-differ reset_previews discarded_previews
