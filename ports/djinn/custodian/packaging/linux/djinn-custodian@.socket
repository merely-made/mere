# Djinn's custodian socket for one desktop user (%i). systemd (pid 1)
# creates and listens on it, so clients see uid 0 as its creator; only the
# owner may connect (0600), and the custodian checks SO_PEERCRED as well.
[Unit]
Description=Djinn custodian socket for %i

[Socket]
ListenStream=/run/djinn-custodian/%i.sock
SocketUser=%i
SocketMode=0600
DirectoryMode=0755
Accept=no
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
