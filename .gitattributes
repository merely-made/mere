# README / marketing media. Treat as binary so git never line-merges or
# attempts a text diff on screenshots and the demo gif.
assets/** binary

# Graphshell receipts are deterministic proof artifacts. Keep their serialized
# bytes stable across Windows and Unix checkouts.
ports/graphshell/docs/receipts/*.html text eol=lf
ports/graphshell/docs/receipts/*.json text eol=lf
ports/distillery/tests/fixtures/** text eol=lf
ports/tabard/tests/fixtures/** text eol=lf
# Fixtures whose digests graphshell's web tests pin (site export, practice dataset).
ports/graphshell/web/fixtures/** text eol=lf
# OpenSSH key fixtures whose slot bytes a test compares to a pre-P4a baseline.
crates/dramatis/personae/tests/fixtures/** text eol=lf

# The Cambium component-catalog receipt test compares the live render against these
# captures byte for byte; autocrlf must not rewrite them on checkout (2026-09-03).
design_docs/cambium_docs/testing/receipts/*.html text eol=lf
crates/cambium/cambium/examples/component_catalog.css text eol=lf

# The Meaning receipt's arXiv corpus (CC0) is pinned by SHA-256 in its
# provenance note; autocrlf must not rewrite its bytes (dynamics grammar plan,
# G2, F43, 2026-10-03).
crates/canvas/pictograph/src/canvas/tests/data/** text eol=lf

# Preserve raw allocator diagnostic log bytes across checkout.
ports/distillery/probe/receipts/2026-09-29_pre4_allocator_stop.log -text
ports/distillery/probe/receipts/2026-09-30_pre4_allocator_control.log -text
ports/distillery/probe/receipts/2026-09-30_pre4_allocator_completion_poll.log -text
# Preserve the exact tested standalone dependency receipt across checkouts.
design_docs/cambium_docs/testing/receipts/generated-names/graphshell-web-Cargo.lock.txt text eol=lf
