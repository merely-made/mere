+pub static ENTRY_CLONE_CALLS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+#[cfg(feature = "clone-counters")]
+pub static ENTRY_CLONED_PAIRS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+#[cfg(feature = "clone-counters")]
+pub static ENTRY_MAX_CLONE_WIDTH: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+#[cfg(feature = "clone-counters")]
+impl Clone for Entries {
+    fn clone(&self) -> Self {
+        use std::sync::atomic::Ordering::Relaxed;
+        ENTRY_CLONE_CALLS.fetch_add(1, Relaxed);
+        ENTRY_CLONED_PAIRS.fetch_add(self.all.len() as u64, Relaxed);
+        ENTRY_MAX_CLONE_WIDTH.fetch_max(self.all.len() as u64, Relaxed);
+        Self { lookup: self.lookup.clone(), all: self.all.clone() }
+    }
